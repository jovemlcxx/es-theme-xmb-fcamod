<theme>
   <formatVersion>7</formatVersion>
   <view name="screen">
      <text name="clock">
         <pos>0.75 0.02</pos>
         <size>0.23 0.05</size>
         <fontSize>0.035</fontSize>
         <color>${textColor}</color>
         <glowColor>${textGlowColor}</glowColor>
         <glowSize>${textGlowSize}</glowSize>
         <glowOffset>${textGlowOffset}</glowOffset>
         <alignment>right</alignment>
         <fontPath>./_inc/fonts/FOT-NewRodin Pro DB.otf</fontPath>
      </text>
   </view>
   <view name="system">
      <carousel name="systemcarousel">
         <type>horizontal</type>
         <logoAlignment>center</logoAlignment>
         <pos>-0.8348 0.20</pos>
         <size>1.98 0.22</size>
         <logoSize>0.168 0.168</logoSize>
         <logoScale>1.3</logoScale>
         <maxLogoCount>11</maxLogoCount>
         <defaultTransition>instant</defaultTransition>
         <origin>0 0</origin>
      </carousel>
      <image name="e_system_content" extra="true">
         <pos>0.1552 0.454</pos>
         <maxSize>0.3501 0.196</maxSize>
         <origin>0.5 0.5</origin>
      </image>
      <text name="e_system_name" extra="true">
         <pos>0.30 0.41</pos>
         <size>0.65 0.07</size>
         <fontSize>0.06</fontSize>
      </text>
      <image name="e_metadata_line" extra="true">
         <pos>0.30 0.50</pos>
         <size>0.72 0.1</size>
         <origin>0 0.5</origin>
      </image>
      <text name="systemInfo">
         <pos>0.30 0.52</pos>
         <size>0.65 0.05</size>
         <fontSize>0.03</fontSize>
      </text>
   </view>
   <view name="system,grid">
      <helpsystem name="help">
         <pos>0.027 0.920</pos>
         <iconColor>00000000</iconColor>
         <textColor>00000000</textColor>
      </helpsystem>
      <image name="e_help_start_icon" extra="true">
         <path>${iconButtonsPath}/${buttonStyle}/start.png</path>
         <pos>0.0495 0.95</pos>
         <maxSize>0.063 0.084</maxSize>
         <origin>0.5 0.5</origin>
         <color>ffffff</color>
         <zIndex>90</zIndex>
      </image>
      <text name="e_help_start_text" extra="true">
         <text>${helpMenu}</text>
         <pos>0.079125 0.920</pos>
         <size>0.20 0.06</size>
         <fontSize>0.035</fontSize>
         <color>${textColorCC}</color>
         <glowColor>${textGlowColor}</glowColor>
         <glowSize>${textGlowSize}</glowSize>
         <glowOffset>${textGlowOffset}</glowOffset>
         <fontPath>./_inc/fonts/FOT-NewRodin Pro DB.otf</fontPath>
         <alignment>left</alignment>
         <verticalAlignment>center</verticalAlignment>
         <zIndex>90</zIndex>
      </text>
      <image name="e_help_a_icon" extra="true">
         <path>${iconButtonsPath}/${buttonStyle}/${confirmButton}.png</path>
         <pos>0.9505 0.95</pos>
         <maxSize>0.063 0.084</maxSize>
         <origin>0.5 0.5</origin>
         <color>ffffff</color>
         <zIndex>90</zIndex>
      </image>
      <text name="e_help_a_text" extra="true">
         <text>${helpSelect}</text>
         <pos>0.919875 0.920</pos>
         <size>0.42 0.06</size>
         <fontSize>0.035</fontSize>
         <color>${textColorCC}</color>
         <glowColor>${textGlowColor}</glowColor>
         <glowSize>${textGlowSize}</glowSize>
         <glowOffset>${textGlowOffset}</glowOffset>
         <fontPath>./_inc/fonts/FOT-NewRodin Pro DB.otf</fontPath>
         <alignment>right</alignment>
         <verticalAlignment>center</verticalAlignment>
         <origin>1 0</origin>
         <zIndex>90</zIndex>
      </text>
   </view>
   <view name="grid">
      <image name="logo">
         <pos>2 2</pos>
      </image>
      <text name="logoText">
         <pos>2 2</pos>
      </text>
      <imagegrid name="gamegrid">
         <pos>0.02 0.125</pos>
         <size>0.30 0.75</size>
         <padding>0 0 0 0</padding>
         <autoLayout>1 3</autoLayout>
         <scrollDirection>verticalCenter</scrollDirection>
         <centerSelection>true</centerSelection>
         <autoLayoutSelectedZoom>1.0</autoLayoutSelectedZoom>
         <imageSource>marquee</imageSource>
         <folderImage>${iconPlaceholderPath}/xmb_folder.png</folderImage>
         <gameImage>${iconPlaceholderPath}/xmb_game.png</gameImage>
         <zIndex>50</zIndex>
         <scrollSound>./_inc/sounds/scroll.wav</scrollSound>
      </imagegrid>
      <gridtile name="default">
         <size>0.30 0.25</size>
         <padding>0 0</padding>
         <imageSizeMode>maxSize</imageSizeMode>
         <backgroundCenterColor>00000000</backgroundCenterColor>
         <backgroundEdgeColor>00000000</backgroundEdgeColor>
      </gridtile>
      <gridtile name="selected">
         <backgroundCenterColor>00000000</backgroundCenterColor>
         <backgroundEdgeColor>00000000</backgroundEdgeColor>
      </gridtile>
      <text name="md_name">
         <pos>0.40 0.42</pos>
         <size>0.60 0.08</size>
         <fontSize>0.035</fontSize>
         <fontPath>${fontBold}</fontPath>
         <color>${textColor}</color>
         <glowColor>${textGlowColor}</glowColor>
         <glowSize>${textGlowSize}</glowSize>
         <glowOffset>${textGlowOffset}</glowOffset>
         <alignment>left</alignment>
         <zIndex>60</zIndex>
      </text>
      <image name="md_line" extra="true">
         <path>${lineImage}</path>
         <pos>0.40 0.50</pos>
         <size>0.60 0.1</size>
         <origin>0 0.5</origin>
         <color>${lineColor}</color>
         <zIndex>55</zIndex>
      </image>
      <text name="md_description">
         <pos>0.40 0.52</pos>
         <size>0.60 0.35</size>
         <fontSize>0.025</fontSize>
         <fontPath>${fontRegular}</fontPath>
         <color>${textColorCC}</color>
         <glowColor>${textGlowColor}</glowColor>
         <glowSize>${textGlowSize}</glowSize>
         <glowOffset>${textGlowOffset}</glowOffset>
         <alignment>left</alignment>
         <zIndex>60</zIndex>
      </text>
      <image name="md_image">
         <pos>0.5 0.5</pos>
         <minSize>1.01 1.01</minSize>
         <origin>0.5 0.5</origin>
         <zIndex>1</zIndex>
      </image>
      <video name="md_video">
         <pos>0.5 0.5</pos>
         <minSize>1.01 1.01</minSize>
         <origin>0.5 0.5</origin>
         <delay>2.0</delay>
         <zIndex>2</zIndex>
      </video>
   </view>
</theme>
