<theme>
   <formatVersion>7</formatVersion>
   <!-- GENERATED by theme-validator/gen_wide.py: game list for 16-9 horizontal. -->
   <view name="grid">
      <imagegrid name="gamegrid">
         <pos>0.0225 0.077</pos>
         <size>0.9475 0.756</size>
         <autoLayout>1 5</autoLayout>
         <padding>0.2025 0 0 0</padding>
      </imagegrid>
      <gridtile name="default">
         <size>0.745 0.14</size>
      </gridtile>
      <image name="gridtile.image">
         <pos>-0.1459 0.5</pos>
         <maxSize>0.2517 1</maxSize>
         <origin>0.5 0.5</origin>
      </image>
      <text name="gridtile">
         <pos>0 0</pos>
         <size>0.7863 1</size>
         <!-- font follows the row height (4:3: 0.04 for rows of 0.14) so shorter rows don't clip it -->
         <fontSize>0.04</fontSize>
      </text>
      <image name="md_line" extra="true">
         <pos>0.225 0.5</pos>
         <size>0.795 0.1</size>
         <origin>0 0.5</origin>
      </image>
      <!-- selected-game info: arrow beside the icon, system name above the name, players + play count under the line (the ES-fcamod has
           no play time field, so the clock icon shows how many times the game was played) -->
      <image name="e_gl_arrow" extra="true">
         <pos>0.012 0.454</pos>
         <maxSize>0.021 0.098</maxSize>
         <origin>0.5 0.5</origin>
      </image>
      <text name="e_gl_system" extra="true">
         <pos>0.225 0.3745</pos>
         <size>0.575 0.045</size>
      </text>
      <image name="e_gl_players_icon" extra="true">
         <pos>0.2378 0.528</pos>
         <maxSize>0.0357 0.0518</maxSize>
      </image>
      <text name="md_players">
         <pos>0.2565 0.512</pos>
         <size>0.075 0.032</size>
      </text>
      <image name="e_gl_plays_icon" extra="true">
         <pos>0.3082 0.528</pos>
         <maxSize>0.0357 0.0518</maxSize>
      </image>
      <text name="md_playcount">
         <pos>0.327 0.512</pos>
         <size>0.09 0.032</size>
      </text>
      <!-- /selected-game info -->
   </view>
</theme>
