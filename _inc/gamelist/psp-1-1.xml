<theme>
   <formatVersion>7</formatVersion>
   <!-- 1:1 screens are taller: 5 items per screen keep each row ~108px, the same height
        as the 3 rows of 4:3, so icons stay as big while showing more games. -->
   <view name="grid">
      <imagegrid name="gamegrid">
         <autoLayout>1 5</autoLayout>
      </imagegrid>
      <gridtile name="default">
         <size>0.94 0.15</size>
      </gridtile>
   </view>
</theme>
