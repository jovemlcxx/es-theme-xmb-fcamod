<theme>
   <formatVersion>7</formatVersion>
   <!-- Game list (PSP XMB): full-width list, icon on the left and the name on the
        right of every item. The right info panel is hidden because the names use its space. -->
   <view name="grid">
      <imagegrid name="gamegrid">
         <pos>0.03 0.125</pos>
         <size>0.94 0.75</size>
         <autoLayout>1 3</autoLayout>
      </imagegrid>
      <gridtile name="default">
         <size>0.94 0.25</size>
      </gridtile>
      <image name="gridtile.image">
         <pos>0 0.5</pos>
         <!-- maxSize keeps the aspect ratio; <size> would stretch the icon -->
         <maxSize>0.36 0.9</maxSize>
         <origin>0 0.5</origin>
      </image>
      <text name="gridtile">
         <pos>0.39 0</pos>
         <size>0.61 1</size>
         <fontPath>${fontRegular}</fontPath>
         <fontSize>0.04</fontSize>
         <color>ffffff88</color>
         <alignment>left</alignment>
         <verticalAlignment>center</verticalAlignment>
      </text>
      <text name="gridtile:selected">
         <fontPath>${fontBold}</fontPath>
         <color>ffffff</color>
      </text>
      <text name="md_name">
         <visible>false</visible>
      </text>
      <image name="md_line" extra="true">
         <visible>false</visible>
      </image>
      <text name="md_description">
         <visible>false</visible>
      </text>
   </view>
   <include subset="aspect-ratio" name="1-1">./psp-1-1.xml</include>
</theme>
