<theme>
   <formatVersion>7</formatVersion>
   <!-- Game list (PSP XMB): icon on the left and the name next to it on every row, 5 rows of
        0.14. The selected row (the middle one) sits right on top of the system view's line
        (same start, same end): grid top = line y - 3 rows. The right info panel is hidden. -->
   <view name="grid">
      <imagegrid name="gamegrid">
         <pos>0.01 0.052</pos>
         <size>0.96 0.756</size>
         <autoLayout>1 5</autoLayout>
         <!-- FCAMOD defaults the grid margin to 0.07 of the screen: without this the rows were
              only 0.084 tall and the icons tiny. Rows of 0.14 + gaps of 0.014 keep the old row
              spacing (0.154), so names and line stay put and only the icons grow. -->
         <margin>0 0.014</margin>
      </imagegrid>
      <gridtile name="default">
         <size>0.96 0.14</size>
      </gridtile>
      <image name="gridtile.image">
         <pos>0.1406 0.5</pos>
         <!-- centered in its box (pos x = half the box width); maxSize keeps the aspect ratio,
              <size> would stretch the icon -->
         <maxSize>0.2813 1</maxSize>
         <origin>0.5 0.5</origin>
      </image>
      <text name="gridtile">
         <!-- names start at x=0.3, where the line starts;
              box is 0.8 of the row: one full line (with descenders) fits, and FCAMOD only wraps
              text above 1.95 x line height (~0.83 of the row on 1:1), so long names get "..."
              instead of a second line. The selected name scrolls. -->
         <pos>0.3019 0.1</pos>
         <size>0.6981 0.8</size>
      </text>
      <image name="md_line" extra="true">
         <pos>0.3 0.5</pos>
         <size>0.72 0.002</size>
         <visible>true</visible>
      </image>
      <text name="gridtile">
         <fontPath>${fontRegular}</fontPath>
         <fontSize>0.04</fontSize>
         <color>ffffff88</color>
         <alignment>left</alignment>
         <verticalAlignment>center</verticalAlignment>
      </text>
      <text name="gridtile:selected">
         <fontPath>${fontBold}</fontPath>
         <color>ffffff</color>
         <singleLineScroll>true</singleLineScroll>
      </text>
      <text name="md_name">
         <visible>false</visible>
      </text>
      <text name="md_description">
         <visible>false</visible>
      </text>
   </view>
   <include subset="aspect-ratio" name="16-9">./psp-16-9.xml</include>
   <include subset="aspect-ratio" name="21-9">./psp-21-9.xml</include>
   <include subset="layout" name="vertical">./psp-vertical.xml</include>
</theme>
