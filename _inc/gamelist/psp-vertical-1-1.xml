<theme>
   <formatVersion>7</formatVersion>
   <!-- Vertical layout (1:1): follow that layout's system view line. -->
   <view name="grid">
      <imagegrid name="gamegrid">
         <pos>0.03 0.087</pos>
         <size>0.94 0.756</size>
         <autoLayout>1 5</autoLayout>
         <!-- rows start where the names start (left padding = icon area): the name sits at x=0 of
              its row and never moves; the icon is centered in the padding area, which is
              still inside the grid, so it is not clipped -->
         <padding>0.3704 0 0 0</padding>
      </imagegrid>
      <gridtile name="default">
         <size>0.5696 0.14</size>
      </gridtile>
      <image name="gridtile.image">
         
         <pos>-0.3432 0.5</pos>
         <maxSize>0.6139 1</maxSize>
         <origin>0.5 0.5</origin>
      </image>
      <text name="gridtile">
         <!-- names start at x=0 of the row = where the line starts;
              box is 0.8 of the row: one full line (with descenders) fits, and FCAMOD only wraps
              text above 1.95 x line height (~0.83 of the row on 1:1), so long names get "..."
              instead of a second line. The selected name scrolls. -->
         <pos>0 0</pos>
         <size>0.606 1</size>
      </text>
      <image name="md_line" extra="true">
         <pos>0.4 0.51</pos>
         <size>0.6 0.1</size>
         <origin>0 0.5</origin>
         <visible>true</visible>
      </image>
      <!-- selected-game info: arrow beside the icon, system name above the name, players + play count under the line (the ES-fcamod has
           no play time field, so the clock icon shows how many times the game was played) -->
      <image name="e_gl_arrow" extra="true">
         <pos>0.016 0.464</pos>
         <maxSize>0.028 0.098</maxSize>
         <origin>0.5 0.5</origin>
      </image>
      <text name="e_gl_system" extra="true">
         <pos>0.4 0.3845</pos>
         <size>0.7 0.045</size>
      </text>
      <image name="e_gl_players_icon" extra="true">
         <pos>0.417 0.538</pos>
         <maxSize>0.0476 0.0518</maxSize>
      </image>
      <text name="md_players">
         <pos>0.442 0.522</pos>
         <size>0.1 0.032</size>
      </text>
      <image name="e_gl_plays_icon" extra="true">
         <pos>0.511 0.538</pos>
         <maxSize>0.0476 0.0518</maxSize>
      </image>
      <text name="md_playcount">
         <pos>0.536 0.522</pos>
         <size>0.12 0.032</size>
      </text>
      <!-- /selected-game info -->
   </view>
</theme>
