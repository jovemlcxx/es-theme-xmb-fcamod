      <helpMenu>MENU</helpMenu>
      <helpSelect>SELECIONAR</helpSelect>
      <aspectRatioLabel>Proporção</aspectRatioLabel>
      <wallpaperLabel>Papel de Parede</wallpaperLabel>
      <layoutLabel>Layout do Sistema</layoutLabel>
      <videoLabel>Vídeo de Fundo</videoLabel>
      <horizontalLabel>Horizontal (XMB Classic)</horizontalLabel>
      <verticalLabel>Vertical (Barra Esquerda)</verticalLabel>
      <enabledLabel>Ativado</enabledLabel>
      <disabledLabel>Desativado</disabledLabel>
      <colorSchemeLabel>Esquema de Cores</colorSchemeLabel>
      <iconStyleLabel>Estilo dos Ícones</iconStyleLabel>
      <footerButtonsLabel>Botões do Rodapé</footerButtonsLabel>
      <iconFlatWhiteLabel>Chapado Branco</iconFlatWhiteLabel>
      <iconFlatBlackLabel>Chapado Preto</iconFlatBlackLabel>
      <darkLabel>Escuro</darkLabel>
      <lightLabel>Claro</lightLabel>
      <wallpaper1Label>1 (padrão)</wallpaper1Label>
      <ratio169Label>16:9 (beta)</ratio169Label>
      <ratio219Label>21:9 (beta)</ratio219Label>
   </variables>
   <subset name="aspect-ratio" displayName="${aspectRatioLabel}">
      <include name="4-3" displayName="4:3" />
      <include name="1-1" displayName="1:1" />
      <include name="16-9" displayName="${ratio169Label}" />
      <include name="21-9" displayName="${ratio219Label}" />
   </subset>
   <subset name="wallpaper" displayName="${wallpaperLabel}">
      <include name="1" displayName="${wallpaper1Label}">./_inc/wallpapers/1.xml</include>
      <include name="2" displayName="2">./_inc/wallpapers/2.xml</include>
      <include name="3" displayName="3">./_inc/wallpapers/3.xml</include>
      <include name="4" displayName="4">./_inc/wallpapers/4.xml</include>
      <include name="5" displayName="5">./_inc/wallpapers/5.xml</include>
      <include name="6" displayName="6">./_inc/wallpapers/6.xml</include>
      <include name="7" displayName="7">./_inc/wallpapers/7.xml</include>
      <include name="8" displayName="8">./_inc/wallpapers/8.xml</include>
      <include name="9" displayName="9">./_inc/wallpapers/9.xml</include>
      <include name="10" displayName="10">./_inc/wallpapers/10.xml</include>
      <include name="11" displayName="11">./_inc/wallpapers/11.xml</include>
      <include name="12" displayName="12">./_inc/wallpapers/12.xml</include>
      <include name="13" displayName="13">./_inc/wallpapers/13.xml</include>
      <include name="14" displayName="14">./_inc/wallpapers/14.xml</include>
      <include name="15" displayName="15">./_inc/wallpapers/15.xml</include>
      <include name="16" displayName="16">./_inc/wallpapers/16.xml</include>
      <include name="17" displayName="17">./_inc/wallpapers/17.xml</include>
      <include name="18" displayName="18">./_inc/wallpapers/18.xml</include>
      <include name="19" displayName="19">./_inc/wallpapers/19.xml</include>
      <include name="20" displayName="20">./_inc/wallpapers/20.xml</include>
   </subset>
   <!-- Icon style: PSP (default), flat white, flat black. Each include sets the paths of the system icons, the menu icons and the horizontal line. -->
   <subset name="icon-style" displayName="${iconStyleLabel}">
      <include name="psp" displayName="${iconPspLabel}">./_inc/icons/psp-style.xml</include>
      <include name="flat-white" displayName="${iconFlatWhiteLabel}">./_inc/icons/flat-white.xml</include>
      <include name="flat-black" displayName="${iconFlatBlackLabel}">./_inc/icons/flat-black.xml</include>
   </subset>
   <!-- ^ it sits BEFORE the background-video subset on purpose: video-enabled.xml reads ${systemTint} when it is parsed, so the icon style must already have set it
        (otherwise the video keeps the dark default tint while the still image gets the style's: the picture darkens when the video starts). -->
   <!-- Background video on/off. It sits AFTER the wallpaper subset on purpose: the video elements are defined in video-enabled.xml and resolve
        ${wallpaperVideoPath} when they are parsed, so the chosen wallpaper must already have set it. "disabled" defines NO video element at all
        (overriding the path/visible of existing elements left the gamelist video playing). -->
   <subset name="background-video" displayName="${videoLabel}">
      <include name="enabled" displayName="${enabledLabel}">./_inc/video-enabled.xml</include>
      <include name="disabled" displayName="${disabledLabel}">./_inc/video-disabled.xml</include>
   </subset>
   <!-- Extra icons around the selected system in the system view (sibling console above, players and add-on below). On by default. -->
   <subset name="layout" displayName="${layoutLabel}">
      <include name="horizontal" displayName="${horizontalLabel}" />
      <include name="vertical" displayName="${verticalLabel}" />
   </subset>
   <subset name="color-scheme" displayName="${colorSchemeLabel}">
      <include name="dark" displayName="${darkLabel}">./_inc/colors/dark.xml</include>
      <include name="light" displayName="${lightLabel}">./_inc/colors/light.xml</include>
   </subset>
   <!-- Button icons of the footer. Paths are built from two plain variables because
        FCAMOD does not resolve a variable inside another variable. -->
   <subset name="button-icons" displayName="${buttonIconsLabel}">
      <include name="nintendo" displayName="Nintendo / Xbox" />
      <include name="playstation" displayName="PlayStation">./_inc/buttons/playstation.xml</include>
   </subset>
   <!-- The footer is hand-made (the native one does not fit the screen), so the confirm
        button has to be set by hand when A/B is swapped in the system settings. -->
   <!-- Footer buttons on / off. After aspect-ratio (which defines the elements) so that "disabled" can hide them. -->
   <subset name="footer-buttons" displayName="${footerButtonsLabel}">
      <include name="enabled" displayName="${enabledLabel}">./_inc/footer-enabled.xml</include>
      <include name="disabled" displayName="${disabledLabel}">./_inc/footer-disabled.xml</include>
   </subset>
   <subset name="confirm-button" displayName="${confirmButtonLabel}">
      <include name="a" displayName="A" />
      <include name="b" displayName="B">./_inc/buttons/confirm-b.xml</include>
   </subset>
   <view name="system, grid, menu">
      <helpsystem name="help">
         <textColor>${helpTextColor}</textColor>
         <iconColor>${helpIconColor}</iconColor>
      </helpsystem>
   </view>
   <view name="menu">
      <menuText name="menutitle">
         <fontPath>${fontBold}</fontPath>
         <fontSize>0.03</fontSize>
         <color>${menuTextSelectedColor}</color>
      </menuText>
      <menuText name="menufooter">
         <fontPath>${fontRegular}</fontPath>
         <fontSize>0.02</fontSize>
         <color>${menuTextColor}</color>
      </menuText>
      <menuText name="menutext">
         <fontPath>${fontBold}</fontPath>
         <fontSize>0.03</fontSize>
         <color>${menuTextColor}</color>
         <separatorColor>${menuSeparatorColor}</separatorColor>
         <selectedColor>${menuTextSelectedColor}</selectedColor>
      </menuText>
      <menuTextSmall name="menutextsmall">
         <fontPath>${fontRegular}</fontPath>
         <fontSize>0.02</fontSize>
         <color>${menuTextColor}</color>
      </menuTextSmall>
      <menuBackground name="menubg">
         <color>${menuBackgroundColor}</color>
      </menuBackground>
      <menuIcons name="menuicons">
         <iconSystem>${iconMenuPath}/System.png</iconSystem>
         <iconUpdates>${iconMenuPath}/Updates.png</iconUpdates>
         <iconGames>${iconMenuPath}/Games.png</iconGames>
         <iconControllers>${iconMenuPath}/Controllers.png</iconControllers>
         <iconUI>${iconMenuPath}/UI.png</iconUI>
         <iconSound>${iconMenuPath}/Sound.png</iconSound>
         <iconNetwork>${iconMenuPath}/Network.png</iconNetwork>
         <iconScraper>${iconMenuPath}/Scraper.png</iconScraper>
         <iconAdvanced>${iconMenuPath}/Advanced.png</iconAdvanced>
         <iconQuit>${iconMenuPath}/Quit.png</iconQuit>
         <iconRestart>${iconMenuPath}/Restart.png</iconRestart>
         <iconShutdown>${iconMenuPath}/Shutdown.png</iconShutdown>
         <iconFastShutdown>${iconMenuPath}/FastShutdown.png</iconFastShutdown>
         <iconRetroachievements>${iconMenuPath}/Retroachievements.png</iconRetroachievements>
      </menuIcons>
      <menuTextEdit name="menutextedit">
         <inactive>${menuTextInputImage}</inactive>
         <active>${menuTextInputImageActive}</active>
      </menuTextEdit>
   </view>
   <!-- System view: one shared background for all systems (not per-system extras),
        so the video keeps playing while scrolling. Drawn under all extras, so the
        dark overlay is applied as a color tint instead of an overlay image. -->
   <view name="system">
      <image name="staticBackground">
         <path>${wallpaperPath}</path>
         <pos>0 0</pos>
         <size>1 1</size>
         <color>${systemTint}</color>
      </image>
   </view>
   <view name="grid">
      <image name="bg_image" extra="true">
         <path>${wallpaperPath}</path>
         <pos>0 0</pos>
         <size>1 1</size>
         <zIndex>0</zIndex>
      </image>
   </view>
   <view name="grid">
      <image name="background_overlay" extra="true">
         <path>${spacerImage}</path>
         <pos>-0.5 -0.5</pos>
         <size>2 2</size>
         <color>${maskColor}</color>
         <zIndex>5</zIndex>
      </image>
   </view>
   <view name="system">
      <carousel name="systemcarousel">
         <type>horizontal</type>
         <logoAlignment>center</logoAlignment>
         <zIndex>40</zIndex>
         <color>00000000</color>
         <maxLogoCount>5</maxLogoCount>
         <logoScale>1.3</logoScale>
         <scrollSound>./_inc/sounds/systembrowse.wav</scrollSound>
      </carousel>
      <!-- No <default> here: the carousel never loads it (FCAMOD leaves an empty slot,
           ES-next ignores it), and without it systems with no icon fall back to logoText. -->
      <image name="logo">
         <path>${systemCarouselImagePath}/${system.theme}.png</path>
      </image>
      <text name="logoText">
         <fontPath>${fontBold}</fontPath>
         <fontSize>0.035</fontSize>
         <color>${textColor}</color>
         <glowColor>${textGlowColor}</glowColor>
         <glowSize>${textGlowSize}</glowSize>
         <glowOffset>${textGlowOffset}</glowOffset>
         <forceUppercase>false</forceUppercase>
      </text>
      <image name="e_system_content" extra="true">
         <path>${systemContentImagePath}/${system.theme}.png</path>
         <default>${systemContentImagePath}/_default.png</default>
         <zIndex>45</zIndex>
      </image>
      <text name="e_system_name" extra="true">
         <text>${system.fullName}</text>
         <fontPath>${fontBold}</fontPath>
         <color>${textColor}</color>
         <glowColor>${textGlowColor}</glowColor>
         <glowSize>${textGlowSize}</glowSize>
         <glowOffset>${textGlowOffset}</glowOffset>
         <alignment>left</alignment>
         <zIndex>50</zIndex>
      </text>
      <image name="e_metadata_line" extra="true">
         <path>${lineImage}</path>
         <color>${lineColor}</color>
         <zIndex>45</zIndex>
      </image>
      <text name="systemInfo">
         <fontPath>${fontRegular}</fontPath>
         <color>${textColor}</color>
         <glowColor>${textGlowColor}</glowColor>
         <glowSize>${textGlowSize}</glowSize>
         <glowOffset>${textGlowOffset}</glowOffset>
         <alignment>left</alignment>
         <zIndex>50</zIndex>
      </text>
   </view>
   <include subset="aspect-ratio" name="4-3">./aspect-ratio-4-3.xml</include>
   <include subset="aspect-ratio" name="1-1">./aspect-ratio-1-1.xml</include>
   <include subset="aspect-ratio" name="16-9">./aspect-ratio-16-9.xml</include>
   <include subset="aspect-ratio" name="21-9">./aspect-ratio-21-9.xml</include>
   <include subset="layout" name="vertical">./_inc/layouts/vertical.xml</include>
   <!-- Game list: PSP XMB style (icon + name on every row; names stay visible while scrolling). -->
   <include>./_inc/gamelist/psp.xml</include>
</theme>
